# Copy this file to .env and fill in the client ID.
#
# Authentication uses PKCE, so there is no client secret. The client ID is not
# sensitive: it is sent in plain text in every authorisation request and is
# visible to anyone who uses the app.
#
# The Client ID is on the app's Basic Information page at
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Must match a redirect URI registered on the app, character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Playlist the station picks from, matched by name among the listener's own
# playlists. Leave empty to ride whatever Spotify plays instead.
LIBRARY_PLAYLIST=Radio TSVN - General Listening

# Name the presenter says on air, as "Radio" followed by this. Write it the way
# it should sound, since the synthesiser reads it literally.
STATION_NAME=T7

# Presenter voice. A Kokoro name such as bm_george, or a Piper name such as
# en_GB-alan-medium. Kokoro names contain no hyphen, Piper names always do.
PRESENTER_VOICE=bm_george

# Newsreader voice. Set to the same value as PRESENTER_VOICE for one voice.
NEWS_VOICE=bf_emma

# Presenter voice in each mode. Leave empty to use PRESENTER_VOICE. Run
# audition_voices.py --mode club (or chill, sunday) to compare voices.
PRESENTER_VOICE_CLUB=
PRESENTER_VOICE_CHILL=
PRESENTER_VOICE_SUNDAY=

# A playlist whose name contains this is a station playlist, and the rest of
# the name selects the mode, for example "Radio TSVN - Club".
PLAYLIST_PREFIX=Radio TSVN

# Piper voice used as the presenter if Kokoro cannot load. Downloads itself on
# first use.
PIPER_VOICE=en_GB-alan-medium

# Spotify crossfade, in milliseconds, matching Settings > Playback > Crossfade.
# Set to 0 if crossfade is off.
CROSSFADE_MS=0

# Bulletin content. Leaving a setting out uses the default shown; setting it to
# nothing switches that section off.

# News categories and headline counts, in reading order. Categories are uk,
# world, politics, business, technology, health, science, entertainment, space
# and local.
NEWS_MIX=uk:2, local:1, world:1, space:1

# RSS feed read as the "local" category. BBC regional feeds follow the pattern
# https://feeds.bbci.co.uk/news/england/<region>/rss.xml, and any RSS feed works.
LOCAL_NEWS_FEED=https://feeds.bbci.co.uk/news/england/london/rss.xml

# Sports in reading order. rugby-premiership and afl have dedicated segments
# with scores. Any other name is a BBC Sport section, such as cricket, football,
# formula1, golf, tennis, rugby-league, boxing, cycling or athletics.
SPORTS=rugby-premiership, athletics, afl

# Weather location. A place name with an optional two letter country code, or
# "latitude, longitude".
WEATHER_LOCATION=London, GB
